APP_ENV=dev
APP_NAME=rag-platform

# Postgres
DATABASE_URL=postgresql+psycopg2://rag:rag@localhost:5432/rag

# Local knowledge base root (PDFs)
LOCAL_KB_ROOT=./data/inbox

# Where to store versioned blobs (copied PDFs)
BLOB_ROOT=./data/blobs

# Chunking
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_PARAS=2

# Retrieval
RETRIEVAL_TOP_K=6

# Optional LLM (leave blank for evidence-only mode)
LLM_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=
